# ============================================================================
# Silicon Notebook —— 环境变量模板（精简版）
# ----------------------------------------------------------------------------
# 这里只列「部署时真正需要设」的变量。100+ 个内部调参旋钮（分词/上下文预算、
# 并发度、检索阈值、日志路径、reasoning 护栏、scale 调度细节等）都已在
# backend/app/core/config.py 里带合理默认值，无需出现在此模板；确需微调时，
# 直接设对应环境变量即可覆盖默认（完整清单与默认值见 config.py 与 README「高级调参」）。
#
# 用法：复制为 .env（放仓库根），按需填写。留空的模型端点=该能力关闭（离线降级）。
# ============================================================================

# ── 主 LLM（OpenAI 兼容，抽取/答案/研究都用它）──────────────────────────
# 留空=纯离线启发式。本地模型示例：
#   OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_COMPAT_API_KEY=local
#   OPENAI_COMPAT_MODEL=qwen2.5:7b-instruct
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ── 可选：分工专用 LLM ──────────────────────────────────────────────────
# 默认全部复用上面的主 LLM。可为「推理搜索 / 查询改写 / KG 抽取」各配独立端点：
#   REASONING_LLM_BASE_URL / _API_KEY / _MODEL  （三项全填才启用；更强的推理模型）
#   REWRITE_LLM_MODEL                            （只填 MODEL 即启用快改写；base/key 缺省复用主端点）
#   KG_LLM_BASE_URL / _API_KEY / _MODEL          （三项全填才启用；批量离线抽取专用）
# 任一组不填齐 → 该路径回退主 LLM。示例（取消注释并填值即生效）：
#   KG_LLM_MODEL=

# ── Embedding（语义召回）────────────────────────────────────────────────
# 留空 EMBED_PROVIDER=仅关键词检索。设 dashscope（大小写不敏感）+ 下面四项启用。
# EMBED_DIM 必须等于模型原生输出维（text-embedding-v4 = 1024）。
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=1024
# 运行时向量维度截断（MRL 前缀截断+re-normalize，省内存）；0=关闭（不截断）。
# ⚠ 库内向量恒按 EMBED_DIM 原生维落库，截断只在读/建/查侧（可逆）。切勿改小 EMBED_DIM
#   来降维——存量向量会被当异维残留丢光（全库静默零召回）。切换需重建 scale 索引。
EMBED_RUNTIME_DIM=0

# ── Rerank（可选，cross-encoder 精排；留空 RERANK_MODEL 即关闭，回退 MMR）──
RERANK_MODEL=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=

# ── PDF 解析（MinerU；无 GPU 留 off，走内置 pypdf 文本兜底）────────────────
# off=内置兜底 | http=远程 mineru-api（填 MINERU_API_URL）| cli=本机子进程跑 MinerU
# VLM 后端才需 MINERU_VLM_SERVER_URL（MINERU_BACKEND=vlm-http-client 时）。
MINERU_MODE=off
MINERU_API_URL=
MINERU_BACKEND=pipeline
MINERU_VLM_SERVER_URL=
# MinerU.net 云（仅「添加链接」的 URL 来源 PDF）。本地 MinerU 已配时优先走本地、
# 内网不外发；未配本地才回退此云 token（https://mineru.net/apiManage/docs 申请）。
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net

# ── 检索/KG 行为开关（影响问答行为，按部署取向调）──────────────────────
KG_AUTO_EXTRACT=false                 # true=上传源后自动抽 KG（默认按需手动「建图」）
KG_INCREMENTAL_FUSION_ENABLED=true    # 上传新源自动增量融合进统一 KG
GRAPH_PPR_ENABLED=true                # reasoning/graph 走 HippoRAG 式 PPR 跨文档传播

# ── 大库索引调度（大库运维）────────────────────────────────────────────
SCALE_INDEX_AUTO_ENABLED=true         # 大库自动建/重建检索索引
SCALE_INDEX_AUTO_WHEN=idle            # idle=低峰窗口重建 | now=立即后台重建
SCALE_SEARCH_INCLUDE_DELTA=false      # false=只搜已索引部分（delta 靠 auto-fold 收进，最终一致）
SCALE_AUTO_FOLD_ON_ADD=true           # 新增内容自动排增量 fold，使 delta 尽快进索引

# ── 用户系统 / 部署 ─────────────────────────────────────────────────────
# 每用户模型配置策略：fallback=用户没配则回退上面系统默认；required=没配则该服务不可用。
USER_MODEL_CONFIG_POLICY=fallback
SILICON_NOTEBOOK_ADMIN_PASSWORD=admin      # admin 初始密码（每次启动据此重置）；生产务必改
SILICON_NOTEBOOK_AUTH_OPTIONAL=false       # true 时无 token 回退 admin（仅本地/测试）；生产留 false
SILICON_NOTEBOOK_ENV=development
DATABASE_URL=sqlite:///.local/silicon_notebook.db
SILICON_NOTEBOOK_STORAGE_DIR=.local/storage
# 允许跨域的前端来源（逗号分隔）；部署改成浏览器实际访问的前端来源。不能用 *（开了 credentials）。
SILICON_NOTEBOOK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# 前端调后端的 API 基址。NEXT_PUBLIC_* 是 Next.js 构建期烘焙进包的（改后要重新 build）。
# 单机部署推荐相对路径 /api（走同源反代免 CORS）；别用 localhost（那指访客自己的机器）。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
