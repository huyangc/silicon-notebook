# 常用部署配置 / Common deployment settings
# 复制为仓库根 .env；只覆盖实际需要改变的值。注释项沿用代码默认值。
# This is a curated starter, not a complete Settings catalog.
# 高级调优、排障、实验和插件预算见源码仓库文档：
# docs/deployment-and-configuration.md / docs/deployment-and-configuration_zh.md
# 独立批处理与迁移工具：scripts/README.md。不要把整份高级参数复制进 .env。

# ── 运行身份与数据 / Runtime and data ────────────────────────────────────
SILICON_NOTEBOOK_ENV=development
# production 或后端对外监听前，必须修改管理员密码。
SILICON_NOTEBOOK_ADMIN_PASSWORD=admin
# 仅本地测试可设 true；生产保持 false，所有请求必须登录。
SILICON_NOTEBOOK_AUTH_OPTIONAL=false
# 默认部署使用 PostgreSQL；开发和生产均需填写实际连接信息。
# PostgreSQL is the default deployment choice for development and production.
DATABASE_URL=postgresql://silicon_app:change-me@127.0.0.1:5432/silicon_notebook
# 可选 SQLite 后端：替换上面的值，勿同时配置两个 DATABASE_URL。
# DATABASE_URL=sqlite:///.local/silicon_notebook.db
SILICON_NOTEBOOK_STORAGE_DIR=.local/storage

# ── 网络接入 / Network ───────────────────────────────────────────────────
# 本机开发使用以下地址。同机服务器部署建议改成 /api，走 Next.js 同源反代；
# 前后端分机时填写浏览器可达的后端 URL，并设置 CORS，不能用访客的 localhost。
# NEXT_PUBLIC_* 在构建时生效；dev.sh/prod.sh 会加载根 .env，单独 build 需显式传入。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# BACKEND_HOST=127.0.0.1
# SILICON_NOTEBOOK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# 公网 MCP 部署设置 HTTPS 强制及 Agent 真正可达的 /mcp 地址。
# MCP_REQUIRE_HTTPS=1
# MCP_PUBLIC_URL=https://notebook.example.com/mcp
# URL 导入可选受信代理 origin，逗号分隔且必须带 http/https scheme。
# 只豁免精确匹配 origin 的公网地址检查；仅填部署者控制的代理。
# URL_IMPORT_TRUSTED_PROXY_HOSTS=""

# ── 模型服务 / Model services ────────────────────────────────────────────
# 复制 model-services.example.toml 到 .local/model-services.toml，修改服务和绑定；
# 模型服务容量只在 TOML 的每服务 max_concurrency 中设置。
# 只填写 TOML 的 api_key_env 引用的密钥。路径留空显式进入离线/确定性降级。
# 旧逐角色配置迁移：python scripts/migrate_legacy_model_env.py --env .env
MODEL_SERVICES_CONFIG=.local/model-services.toml
# 绑定表在启动时硬校验：[bindings] 缺工作负载或多出未知/已退役 id 一律拒启（路径留空的
# 离线模式不受此限）。下面这行仅升级过渡期临时放行（缺/多绑定只告警不拒启），不要长期开着。
# MODEL_BINDINGS_STRICT=false
SYSTEM_GENERAL_API_KEY=""
SYSTEM_REASONING_API_KEY=""
SYSTEM_EMBEDDING_API_KEY=""
SYSTEM_RERANK_API_KEY=""
# 必须与 embedding 模型原生输出维度一致；不要通过改小它给已有向量降维。
EMBED_DIM=1024

# 工作负载输出上限须适配模型：prompt + max_tokens 不得超过模型上下文窗口。
# 以下为代码默认值，需要调整时再取消注释；这些上限不是模型并发容量。
# OPENAI_COMPAT_TIMEOUT_SECONDS=60
# OPENAI_COMPAT_MAX_TOKENS=8192
# ANSWER_MAX_TOKENS=16384
# REASONING_MAX_TOKENS=16384
# KG_EXTRACT_MAX_TOKENS=51200
# REPORT_SECTION_MAX_TOKENS=65536
# REPORT_SYNTHESIS_MAX_TOKENS=102400
# REPORT_SUMMARY_MAX_TOKENS=102400
# KG_LLM_TIMEOUT_SECONDS=60
# EMBED_BATCH_SIZE=10
# EMBED_TRUNCATE_CHARS=2000

# ── 并发与内存 / Capacity ────────────────────────────────────────────────
# 任务并发独立于 TOML 的模型服务并发；按机器和数据库容量调整。
# KG_JOB_CONCURRENCY=8
# REPORT_GENERATION_CONCURRENCY=1
# REPORT_SECTION_CONCURRENCY=5
# BACKGROUND_MAINTENANCE_CONCURRENCY=4
# BACKGROUND_LIGHT_JOB_CONCURRENCY=4
# SEARCH_CONCURRENCY_LIMIT=4
# SCALE_BUILD_CONCURRENCY=2
# 检索缓存按活跃笔记本数和内存预算调整，具体限制见部署文档。
# VECTOR_CACHE_MAX_BYTES=17179869184
# VECTOR_CACHE_PER_FAMILY_ENTRIES=8
# SCALE_IDX_CACHE_MAX=8
# SCALE_IDX_CACHE_MAX_LARGE=2
# 模型结果缓存；同名模型换权重后应通过管理员缓存接口清理旧结果。
# LLM_CACHE_ENABLED=true
# LLM_CACHE_PATH=.local/llm_cache_v2.db
# LLM_CACHE_SIZE_LIMIT=2147483648
# LLM_CACHE_TTL_DAYS=90

# ── 使用与保留策略 / Usage and retention ─────────────────────────────────
# 单文件上传上限，1 MB = 1024 * 1024 字节；每次最多 20 个文件由协议固定。
# SOURCE_UPLOAD_MAX_MB=50
# 每个笔记本的上传文档默认上限；管理员设置的全局默认值或用户级覆盖值优先。
# USER_UPLOAD_DOCUMENT_LIMIT=20
# 完整模型日志可能包含原文、提示词和回答；按部署的数据保留要求选择。
# LLM_LOG_ENABLED=true
# LLM_LOG_PATH=.local/logs/llm.jsonl
# EVENT_LOG_ENABLED=true
# EVENT_LOG_DIR=.local/logs
# 只读日志查看器默认关闭；用户活动视图独立控制。
# DEBUG_LOGS_ENABLED=false
# USER_ACTIVITY_VIEW_ENABLED=true
# 删除笔记本后的活动元数据保留天数，不保留答案、来源或报告正文。
# USER_ACTIVITY_RETENTION_DAYS=180
# 解析/表格分析失败样本的私有归档保留天数。
# ANALYSIS_FAILURE_RETENTION_DAYS=30
# 可按功能与成本策略关闭自动 KG 抽取或表格分析。
# KG_AUTO_EXTRACT=false
# SPREADSHEET_ANALYSIS_ENABLED=true
# 挂载参考库的原文段落是否参与 chunk 检索；关闭即回到只检索当前笔记本原文。
# CHUNK_FEDERATION_ENABLED=true

# ── 可选解析服务 / Optional PDF parser ──────────────────────────────────
# 默认 off 使用本地 PyMuPDF4LLM 回退；外接 MinerU 配 http 和 API 地址。
# MINERU_MODE=off
# MINERU_API_URL=""
# MINERU_BACKEND=pipeline
# 使用 vlm-http-client 等客户端 backend 时配置独立 VLM 服务。
# MINERU_VLM_SERVER_URL=""
# MINERU_TIMEOUT_SECONDS=600
# 云端 token 在未配置本地 MinerU 时用于支持格式的文件/URL 解析；按需留空。
# MINERU_API_TOKEN=""
# MINERU_API_BASE=https://mineru.net
# 语言、公式/表格/图片、云端重试与批处理参数见部署文档和 scripts/README.md。

# ── 可选部署插件 / Optional deployment extensions ──────────────────────
# 指向部署者的扩展 TOML；空值不加载部署插件，修改后重启。
# EXTENSIONS_CONFIG=""
# 插件点的超时/调用/输出预算与实验 rollout 配置见部署文档的对应章节。
