SILICON_NOTEBOOK_ENV=development
SILICON_NOTEBOOK_SINGLE_USER_EMAIL=local-user@silicon-notebook.dev
SILICON_NOTEBOOK_SINGLE_USER_NAME=Local Curator

# LLM for extraction / answers / article research (OpenAI-compatible). Leave
# blank to use deterministic heuristics offline. For real LLM-quality knowledge
# extraction without cloud, point these at a LOCAL OpenAI-compatible server
# (e.g. ollama, `mlx_lm.server`, llama.cpp), e.g.:
#   OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_COMPAT_API_KEY=local
#   OPENAI_COMPAT_MODEL=qwen2.5:7b-instruct
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_TIMEOUT_SECONDS=60

# Embeddings (semantic recall). Empty EMBED_PROVIDER disables embeddings
# (keyword search only). Set all four provider/base/key/model vars to enable
# a DashScope/OpenAI-compatible embedding API. EMBED_DIM must match the model's
# output dimension (text-embedding-v4 = 1024).
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=1024

# KG extraction concurrency (two levels) + adaptive windowing.
# - KG_EXTRACT_WORKERS: GLOBAL cap on concurrent extraction LLM calls (windows),
#   shared across ALL documents (intra- + inter-doc). Keep it below your LLM
#   provider's concurrency limit so interactive Ask keeps headroom.
# - KG_JOB_CONCURRENCY: how many documents extract at once (job pool); their
#   windows all share the global KG_EXTRACT_WORKERS budget.
# - KG_ASK_RESERVE: LLM connections reserved for interactive Ask so it is not
#   starved while extraction saturates the pool (pool = WORKERS + RESERVE).
# - Window size is adaptive by default (KG_WINDOW_TARGET_CHARS=0):
#   level = clamp(content_chars / KG_EXTRACT_WORKERS, MIN, MAX), balanced split.
#   Set KG_WINDOW_TARGET_CHARS > 0 to force a fixed window size.
KG_EXTRACT_WORKERS=16
KG_JOB_CONCURRENCY=8
KG_ASK_RESERVE=64
KG_WINDOW_TARGET_CHARS=0
KG_WINDOW_MIN_CHARS=4000
KG_WINDOW_MAX_CHARS=8000
KG_WINDOW_OVERLAP_CHARS=450
KG_WINDOW_WARN_THRESHOLD=1200

# LLM interaction logging: records every chat/embedding call (request, response,
# latency, tokens, errors) to a JSONL file plus a brief console line. Defaults
# on; it is a no-op when no LLM is configured (offline).
LLM_LOG_ENABLED=true
LLM_LOG_PATH=.local/logs/llm.jsonl
LLM_LOG_MAX_CHARS=4000

# General event logging: HTTP requests + async pipeline stages + status
# transitions, written to <EVENT_LOG_DIR>/<channel>.jsonl plus the console.
# Tail .local/logs/requests.jsonl and .local/logs/events.jsonl to see what the
# app is doing and where an upload is stuck. SLOW_REQUEST_MS flags slow calls.
EVENT_LOG_ENABLED=true
EVENT_LOG_DIR=.local/logs
SLOW_REQUEST_MS=3000

# Read-only browser/API viewer for .local/logs records. Full LLM records may
# include prompt/response text from private source material, so this is opt-in.
DEBUG_LOGS_ENABLED=false

# PDF parsing via MinerU (formulas/tables/layout). Leave MINERU_MODE=off on
# machines without a GPU; PDFs then use the built-in pypdf text fallback.
# On the GPU deployment host, run `mineru-api` and point MINERU_API_URL at it:
#   MINERU_MODE=http
#   MINERU_API_URL=http://<gpu-host>:8000
# Or run MinerU's Python API in an isolated subprocess on the same host:
# MINERU_MODE=cli (requires the `mineru` Python package installed).
# To offload only the VLM model to a standalone vllm/sglang server, use a client
# backend (MINERU_BACKEND=vlm-http-client) and set MINERU_VLM_SERVER_URL.
MINERU_MODE=off
MINERU_API_URL=
MINERU_BACKEND=pipeline
MINERU_VLM_SERVER_URL=
MINERU_PARSE_METHOD=auto
MINERU_LANG=
# For local VLM full-paper parsing, raise this in .env (for example 1800).
MINERU_TIMEOUT_SECONDS=600
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

DATABASE_URL=sqlite:///.local/silicon_notebook.db
SILICON_NOTEBOOK_STORAGE_DIR=.local/storage
SILICON_NOTEBOOK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
