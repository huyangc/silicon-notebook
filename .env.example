SILICON_NOTEBOOK_ENV=development
SILICON_NOTEBOOK_SINGLE_USER_EMAIL=local-user@silicon-notebook.dev
SILICON_NOTEBOOK_SINGLE_USER_NAME=Local Curator

# 每用户模型配置策略：fallback=用户未在「设置·模型服务」里配置时，回退到下面这些
# 系统默认（第一阶段，老部署零感知）；required=用户未配置则该服务不可用，问答经
# model_error 横幅提示「请先配置」（第二阶段，切换只需改此一项）。
USER_MODEL_CONFIG_POLICY=fallback

# LLM for extraction / answers / article research (OpenAI-compatible). Leave
# blank to use deterministic heuristics offline. For real LLM-quality knowledge
# extraction without cloud, point these at a LOCAL OpenAI-compatible server
# (e.g. ollama, `mlx_lm.server`, llama.cpp), e.g.:
#   OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_COMPAT_API_KEY=local
#   OPENAI_COMPAT_MODEL=qwen2.5:7b-instruct
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_TIMEOUT_SECONDS=60

# 推理搜索 (mode=reasoning) 专用 LLM（可选）。三项全部填写时推理路径改用此模型，
# 与全局 OPENAI_COMPAT_* 解耦（典型：抽取走快模型、推理走更强的推理/thinking 模型）。
# 任一为空 → 整体回退到上面的 OPENAI_COMPAT_*。推理的超时/重试沿用代码中的
# reasoning 默认（REASONING_TIMEOUT_SECONDS / REASONING_MAX_RETRIES），此处不单列。
REASONING_LLM_BASE_URL=
REASONING_LLM_API_KEY=
REASONING_LLM_MODEL=

# 查询改写/扩展专用「快模型」（可选）。设了 REWRITE_LLM_MODEL 即启用；
# base_url/api_key 留空则复用全局 OPENAI_COMPAT_*。
REWRITE_LLM_BASE_URL=
REWRITE_LLM_API_KEY=
REWRITE_LLM_MODEL=

# KG 构建/融合专用 LLM（可选，批量离线抽取）。三项全部填写时 KG 路径改用此模型，
# 任一为空 → 回退全局 OPENAI_COMPAT_*。
KG_LLM_BASE_URL=
KG_LLM_API_KEY=
KG_LLM_MODEL=

# Embeddings (semantic recall). Empty EMBED_PROVIDER disables embeddings
# (keyword search only). Set all four provider/base/key/model vars to enable
# a DashScope/OpenAI-compatible embedding API. EMBED_DIM must match the model's
# output dimension (text-embedding-v4 = 1024).
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=1024
# 嵌入端点限流时的重试（指数退避）。被 429/限流卡住就调大。
EMBED_RATE_LIMIT_RETRIES=5
EMBED_RATE_LIMIT_BASE_DELAY=2.0

# KG extraction concurrency (two levels) + adaptive windowing.
# - KG_EXTRACT_WORKERS: GLOBAL cap on concurrent extraction LLM calls (windows),
#   shared across ALL documents (intra- + inter-doc). Keep it below your LLM
#   provider's concurrency limit so interactive Ask keeps headroom.
# - KG_JOB_CONCURRENCY: how many documents extract at once (job pool); their
#   windows all share the global KG_EXTRACT_WORKERS budget.
# - KG_ASK_RESERVE: LLM connections reserved for interactive Ask so it is not
#   starved while extraction saturates the pool (pool = WORKERS + RESERVE).
# - Window size is adaptive by default (KG_WINDOW_TARGET_CHARS=0):
#   level = clamp(content_chars / KG_EXTRACT_WORKERS, MIN, MAX), balanced split.
#   Set KG_WINDOW_TARGET_CHARS > 0 to force a fixed window size.
KG_EXTRACT_WORKERS=16
KG_JOB_CONCURRENCY=8
KG_ASK_RESERVE=64
KG_WINDOW_TARGET_CHARS=0
KG_WINDOW_MIN_CHARS=4000
KG_WINDOW_MAX_CHARS=8000
KG_WINDOW_OVERLAP_CHARS=450
KG_WINDOW_WARN_THRESHOLD=1200
KG_RELINK_ENABLED=true  # 抽取后自动补连孤立节点(共享证据元素+名字命中)

# === Retrieval / KG enhancements (GraphRAG + ToG-3 borrow, Phase 1+2) ===
# A mix of opt-in (default off) and on-by-default knobs; validate with the eval harness
# (app/eval) before changing. ON by default: ANSWER_CONTEXT_*, KG_QUERY_REFINE_ENABLED,
# and the KG-quality passes KG_REFINE / KG_GLEANING / KG_CONCEPT_DESC (2026-06-18).
# Note: enabling RRF + rerank + query-refine all at once regressed in eval — don't.

# LLM response cache (key = model+messages+schema; separate sqlite, isolated from the
# main KG DB). Makes re-extraction / re-runs near-free.
LLM_CACHE_ENABLED=false
LLM_CACHE_PATH=.local/llm_cache.db

# Extraction self-verify: after each window, one extra LLM pass drops hallucinated nodes.
KG_REFINE_ENABLED=true
# Gleaning: after the first extraction, up to N extra rounds ask the LLM for MISSED nodes.
KG_GLEANING_ENABLED=true
KG_GLEANING_ROUNDS=1
# Concept-cluster description fusion: cross-doc concept clusters (>=2 members) get one
# LLM-fused description from their evidence.
KG_CONCEPT_DESC_ENABLED=true
# Community summaries: LLM title/summary/findings per Louvain community (needed for
# Global search, ask mode="global").
KG_COMMUNITY_SUMMARY_ENABLED=false

# Answer-context assembly char budget (always on): total budget + keep >= N items.
ANSWER_CONTEXT_BUDGET_CHARS=6000
ANSWER_CONTEXT_MIN_ITEMS=3
# Retrieval ranking: BM25 (Okapi) + RRF fusion instead of the default keyword+semantic
# weighted fusion. RETRIEVAL_RRF_K = reciprocal-rank-fusion k. (Tune before enabling.)
RETRIEVAL_RRF_ENABLED=false
RETRIEVAL_RRF_K=60
# Question-aware evidence refinement: before answering, extract the question-relevant
# points from the assembled evidence and prepend them. DEFAULT ON (eval: correctness up
# + fabricated citations -> 0; cost: 1 extra LLM call per ask). Set false to disable.
KG_QUERY_REFINE_ENABLED=true
QUERY_REFINE_MAX_CHARS=4000
# Global map-reduce QA (ask mode="global"): max community reports considered (by size).
GLOBAL_MAX_COMMUNITIES=20
# Relation-vector retrieval for graph/reasoning seeds: when enabled, the retrieval
# path also queries the relation-embedding index and merges hits as graph seeds.
# Opt-in pending eval (default off). RELATION_SEED_TOP_N = hits fed to graph seeds.
RELATION_RETRIEVAL_ENABLED=false
RELATION_SEED_TOP_N=8
# KG retrieval-quality pass (default off, opt-in pending eval):
KG_CANONICAL_FOLD_ENABLED=false
KG_ABOUT_DOWNWEIGHT_ENABLED=false
KG_ISOLATED_RANK_PENALTY=0.5  # 孤立(无边)KG 节点的检索排序降权乘子;仅压 score 不动 relevance

# 常用功能开关（默认值见右侧；按需改）
KG_AUTO_EXTRACT=false                 # true=上传源后自动抽取 KG（默认按需手动建图）
KG_INCREMENTAL_FUSION_ENABLED=true    # 上传新源时自动增量融合进统一 KG
KG_CONFLICT_RESOLUTION_ENABLED=false  # 冲突检测→LLM 裁决→写回 + 评审队列
GRAPH_PPR_ENABLED=true                # reasoning/graph 走 HippoRAG 式 PPR 跨文档传播
QUERY_REWRITE_ENABLED=true            # 问答前查询改写/扩展

# === Retrieval / extraction tuning (advanced; defaults are usually fine) ===
RETRIEVAL_TOP_N=12
PROC_MIN=2
# grounded 三档阈值(作用于融合相关度 [0,1])。
EVIDENCE_TAU_LOW=0.18
EVIDENCE_TAU_HIGH=0.35
# Reasoning mode (mode=reasoning) guardrails + interactive short timeout/retries.
REASONING_MAX_STEPS=50
REASONING_MAX_SUBQUERIES=5
REASONING_TIMEOUT_SECONDS=90
REASONING_MAX_RETRIES=1
# Embedding tuning + sqlite busy timeout + LLM connection retries.
EMBED_TRUNCATE_CHARS=2000
EMBED_BATCH_SIZE=10
EMBED_PERSIST_CHUNK=200
EMBED_CONCURRENCY=8
DB_BUSY_TIMEOUT_MS=30000
OPENAI_COMPAT_MAX_RETRIES=2

# LLM interaction logging: records every chat/embedding call (request, response,
# latency, tokens, errors) to a JSONL file plus a brief console line. Defaults
# on; it is a no-op when no LLM is configured (offline).
LLM_LOG_ENABLED=true
LLM_LOG_PATH=.local/logs/llm.jsonl
LLM_LOG_MAX_CHARS=4000

# General event logging: HTTP requests + async pipeline stages + status
# transitions, written to <EVENT_LOG_DIR>/<channel>.jsonl plus the console.
# Tail .local/logs/requests.jsonl and .local/logs/events.jsonl to see what the
# app is doing and where an upload is stuck. SLOW_REQUEST_MS flags slow calls.
EVENT_LOG_ENABLED=true
EVENT_LOG_DIR=.local/logs
SLOW_REQUEST_MS=3000

# Read-only browser/API viewer for .local/logs records. Full LLM records may
# include prompt/response text from private source material, so this is opt-in.
DEBUG_LOGS_ENABLED=false

# PDF parsing via MinerU (formulas/tables/layout). Leave MINERU_MODE=off on
# machines without a GPU; PDFs then use the built-in pypdf text fallback.
# On the GPU deployment host, run `mineru-api` and point MINERU_API_URL at it:
#   MINERU_MODE=http
#   MINERU_API_URL=http://<gpu-host>:8000
# Or run MinerU's Python API in an isolated subprocess on the same host:
# MINERU_MODE=cli (requires the `mineru` Python package installed).
# To offload only the VLM model to a standalone vllm/sglang server, use a client
# backend (MINERU_BACKEND=vlm-http-client) and set MINERU_VLM_SERVER_URL.
MINERU_MODE=off
MINERU_API_URL=
MINERU_BACKEND=pipeline
MINERU_VLM_SERVER_URL=
MINERU_PARSE_METHOD=auto
MINERU_LANG=
MINERU_MODEL_SOURCE=huggingface
# For local VLM full-paper parsing, raise this in .env (for example 1800).
MINERU_TIMEOUT_SECONDS=600
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# MinerU.net cloud (v4) — parse public PDF URLs via the hosted service.
# 用于「添加链接」加入的 PDF 来源；当上面的本地 MinerU（MINERU_MODE=http/cli）
# 已配置时，URL 来源会优先走本地解析（内网部署下 PDF 不外发），仅在未配置本地
# 时回退到此云端 token。从 https://mineru.net/apiManage/docs 申请 token 后填入：
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net
MINERU_CLOUD_MODEL_VERSION=vlm
MINERU_CLOUD_LANGUAGE=ch
MINERU_CLOUD_FORMULA_ENABLE=true
MINERU_CLOUD_TABLE_ENABLE=true
MINERU_CLOUD_TIMEOUT_SECONDS=600
MINERU_CLOUD_POLL_INTERVAL_SECONDS=5

# 用户系统 / User accounts
# admin 账号初始密码（每次后端启动据此重置 admin 密码；改密=改此值后重启）
SILICON_NOTEBOOK_ADMIN_PASSWORD=admin
# true 时无 token 的请求回退为 admin（仅本地/测试）；生产留 false=强制登录
SILICON_NOTEBOOK_AUTH_OPTIONAL=false

DATABASE_URL=sqlite:///.local/silicon_notebook.db
SILICON_NOTEBOOK_STORAGE_DIR=.local/storage
# 允许跨域的前端来源(逗号分隔)。部署到服务器时改成浏览器实际访问的前端来源,
# 如 http://<服务器IP或域名>:3000。不能用 *(后端开了 credentials)。
SILICON_NOTEBOOK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# 前端调用的后端 API 基址。NEXT_PUBLIC_* 是 Next.js 构建期烘焙进包的(改后要重新 build):
#  - 开发(npm run dev / scripts/dev.sh)会从本文件读到;
#  - 生产(npm run build)需放到 frontend/.env.local(或 build 命令的环境)才生效。
# 单台同机部署 + 远程访问推荐填相对路径 /api(走 next.config.mjs 的同源反代,免 CORS、
#   后端不必对外暴露);前后端分不同 host 才填 http://<服务器IP或域名>:8000/api。
# 任何情况都别用 localhost/127.0.0.1(那指访客自己的机器)。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ── chunk-native 通用问答 + chunk×graph mix ──────────────────────────────
# 通用问答(mode=chunk)走 chunk-native:大召回 → 选择 → 长上下文综合。
CHUNK_RECALL=200               # 每子查询 chunk 大召回数(mix 候选池 / 无 rerank 时 MMR 候选)
CHUNK_MMR_K=16                 # 无 rerank 时 MMR 精选的 chunk 数
# chunk×graph mix:把 KG 局部结构(实体 + 1-hop 关系)及其源 chunk 叠加进 chunk 答案。
# 仅当 qwen3-rerank 配齐(RERANK_MODEL + RERANK_API_KEY)时生效;否则回退纯 chunk MMR。
CHUNK_KG_OVERLAY_ENABLED=true
# qwen3-rerank(DashScope text-rerank):cross-encoder 精排 mix 候选 chunk。
# 留空 RERANK_MODEL → 关闭 rerank,mix 回退 MMR(不报错)。
RERANK_MODEL=                  # 例:qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1   # DashScope 原生 text-rerank(非 compatible-mode)
RERANK_API_KEY=                # 必填(DashScope key);留空则视为未配,mix 回退 MMR
RERANK_MAX_DOCS=500            # 单请求文档上限,超出自动切 batch 并发再按分合并
# rerank 接口风格:dashscope=DashScope 原生 text-rerank(嵌套 input/output,默认);
# openai=OpenAI 兼容 {base}/rerank(扁平 body、顶层 results,vLLM/Cohere 等;别名 vllm/cohere/compatible)。
RERANK_API_STYLE=dashscope
# mix token 预算(照 LightRAG 实际值):实体段 / 关系段 / 总预算。chunk 段吃总预算余量。
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
