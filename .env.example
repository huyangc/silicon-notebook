SILICON_NOTEBOOK_ENV=development
SILICON_NOTEBOOK_SINGLE_USER_EMAIL=local-user@silicon-notebook.dev
SILICON_NOTEBOOK_SINGLE_USER_NAME=Local Curator

# Maximum size for one uploaded source file. 1 MB = 1024 * 1024 bytes.
# A single multipart request is additionally capped at 20 files.
SOURCE_UPLOAD_MAX_MB=50

# 模型服务由部署者统一管理。复制 model-services.example.toml 到
# .local/model-services.toml，按部署实际修改服务/绑定/每服务 max_concurrency，
# 再在本文件填入 TOML 的 api_key_env 所引用的密钥。配置路径留空时，系统明确
# 进入离线/确定性降级；不再读取旧的逐角色模型端点变量。
# 旧部署可先运行 `python scripts/migrate_legacy_model_env.py --env .env` 预览；
# 离线发布包使用 `.venv/bin/python`。确认后加 `--apply` 自动生成 TOML、备份并迁移。
MODEL_SERVICES_CONFIG=.local/model-services.toml
SYSTEM_GENERAL_API_KEY=
SYSTEM_REASONING_API_KEY=
SYSTEM_EMBEDDING_API_KEY=
SYSTEM_RERANK_API_KEY=

# 模型调用超时和工作负载输出预算；这些不是并发容量。并发容量只在部署 TOML
# 的每个服务 `max_concurrency` 中设置。
OPENAI_COMPAT_TIMEOUT_SECONDS=60
# Max output tokens (max_tokens) per LLM call. OPENAI_COMPAT_MAX_TOKENS is the
# GLOBAL default for all generation calls (query rewrite/expand, conflict/merge
# review, graph-reason, metadata, …); 0 = omit the param and let the server decide.
# Answer synthesis and KG extraction emit longer output and use their own higher
# caps below (ANSWER_MAX_TOKENS / KG_EXTRACT_MAX_TOKENS). Raise only within your
# model's output-window limit — max_tokens shares the model's total context with
# the (often large) input, so an over-high cap can overflow the window.
OPENAI_COMPAT_MAX_TOKENS=8192
# Answer synthesis (chunk / mix / reasoning / graph final answer) output cap.
ANSWER_MAX_TOKENS=16384
# Cooperative, post-terminal completion-observer point budget.
ASK_POST_COMPLETION_EXTENSION_TIMEOUT_SECONDS=30
REPORT_POST_COMPLETION_EXTENSION_TIMEOUT_SECONDS=30

# 深度报告把数据库扇出与模型服务并发分开治理。每进程默认只同时生成一篇报告，
# 每篇最多并行五节；模型调用仍受 model-services.toml 的 max_concurrency 全局约束。
# 高档报告的全篇证据蓝图使用独立输出预算，避免继承全局 8192 后截断 JSON。
REPORT_GENERATION_CONCURRENCY=1
REPORT_SECTION_CONCURRENCY=5
# 每篇报告的节 worker 共用一个叶子检索扇出闸；规划探针最多并行 KG/原文两通道。
REPORT_RETRIEVAL_FANOUT=8
REPORT_PROBE_CHANNEL_CONCURRENCY=2
# 后台任务并发:重活(图谱分析/重建、补上关联、统一图重建、冲突检测、合并预审)
# 与秒级轻活(论文元数据补抽、命令目录识别、knowhow 投影与清扫)分两个独立的池,
# 免得几个小时级重建把用户点一下就该出结果的轻活饿死。ask-*/report-* 不进池。
BACKGROUND_MAINTENANCE_CONCURRENCY=4
BACKGROUND_LIGHT_JOB_CONCURRENCY=4
# 充分性是可评测的效果规则，默认值保持历史判定。
REPORT_SUFFICIENCY_MIN_RELEVANT_ITEMS=3
REPORT_SUFFICIENCY_MIN_FAMILIES=2
REPORT_SUFFICIENCY_COMPLETE_MIN_FAMILIES=3
REPORT_SUFFICIENCY_MAX_TOP_FAMILY_SHARE=0.8
# 这里只控制 completion 上限；模型实际总上下文由 model-services.toml 绑定的
# provider/model 决定，部署者必须确认 prompt + max_tokens 落在其能力内。
REPORT_SECTION_MAX_TOKENS=65536
REPORT_SYNTHESIS_MAX_TOKENS=102400
REPORT_SUMMARY_MAX_TOKENS=102400

# 单次 KG 模型请求的超时与瞬态故障重试上限。重试次数限制为 0..3；
# 超时/持续不可达耗尽后只中断当前 notebook 的本次 KG 任务。
KG_LLM_TIMEOUT_SECONDS=60
KG_LLM_MAX_RETRIES=2

# EMBED_DIM must match the embedding service model's output dimension.
EMBED_DIM=1024
# 运行时向量维度截断(MRL 前缀截断 + re-normalize):相似度/矩阵/ANN 在截断后空间进行,
# 使进程内内存约 EMBED_DIM/N× 缩减;0=关(不截断)。库内向量恒按 EMBED_DIM 原生维落库
# (真相源可逆),截断只在读/建/查侧。开关它需重建 scale 索引,见
# docs/runtime-dim-truncation-runbook.md。⚠切勿改小 EMBED_DIM 来降维(存量向量会被当异维丢光)。
EMBED_RUNTIME_DIM=0
# 嵌入端点限流时的重试（指数退避）。被 429/限流卡住就调大。
EMBED_RATE_LIMIT_RETRIES=5
EMBED_RATE_LIMIT_BASE_DELAY=2.0

# KG source-job concurrency + adaptive windowing. Model calls from every source
# share the bound service scheduler; the service's TOML `max_concurrency` is the
# only model-capacity setting. KG_JOB_CONCURRENCY only controls source jobs.
# Window size is adaptive by default (KG_WINDOW_TARGET_CHARS=0), using the
# `kg_extract` binding's service capacity to split content evenly.
#   Set KG_WINDOW_TARGET_CHARS > 0 to force a fixed window size.
# KG extraction output cap: a window can yield many nodes/relations (large JSON),
# so give it headroom — truncation → invalid JSON → silently empty extraction.
# But keep it within your model's context window: some OpenAI-compatible servers
# reject prompt_tokens + max_tokens > max_model_len with a 400. 0 = omit (server default).
KG_EXTRACT_MAX_TOKENS=51200
KG_JOB_CONCURRENCY=8
KG_WINDOW_TARGET_CHARS=0
KG_WINDOW_MIN_CHARS=4000
KG_WINDOW_MAX_CHARS=8000
KG_WINDOW_OVERLAP_CHARS=450
KG_WINDOW_WARN_THRESHOLD=1200
KG_RELINK_ENABLED=true  # 抽取后自动补连孤立节点(共享证据元素+名字命中)

# 概念聚类/合并的 hnswlib ANN 建索引线程数。0=按机器核数自动(min(cpu,32))。
# 这是本地 ANN 计算线程数，不是模型服务并发容量。
KG_CLUSTER_ANN_THREADS=0
# 启动脚本(dev.sh/prod.sh)按核数自动设 OMP/OPENBLAS/MKL 线程(未显式设时)。
# 设 AUTOTUNE=0 关闭该自动行为。
# AUTOTUNE=1

# === Retrieval / KG enhancements (GraphRAG + ToG-3 borrow, Phase 1+2) ===
# A mix of opt-in (default off) and on-by-default knobs; validate with the eval harness
# (app/eval) before changing. ON by default: ANSWER_CONTEXT_*, KG_QUERY_REFINE_ENABLED,
# and the KG-quality passes KG_REFINE / KG_GLEANING / KG_CONCEPT_DESC (2026-06-18).
# Note: enabling RRF + rerank + query-refine all at once regressed in eval — don't.

# 启动就绪前严格预加载所有已发布 scale 索引、启用的 ANN handle 与可安全复用的
# 单索引 PPR core，把大库磁盘冷加载从首个用户请求前置到 readiness gate。跨库
# mounted combined graph 不在启动时全量物化，避免为每种组合复制千万节点图而 OOM。
# 索引总数必须不超过
# SCALE_IDX_CACHE_MAX，否则启动保持 not-ready，避免“预热时刚加载又被 LRU 淘汰”。
# 紧急进入 UI 修复损坏索引时可临时设 false；正常长期运行部署保持 true。
STARTUP_PRELOAD_SCALE_INDEXES=true
SCALE_IDX_CACHE_MAX=8

# Content-addressed cache for LLM + embedding calls (key = model+content; separate
# sqlite, isolated from the main DB). Repeat calls over identical content reuse the
# prior result instead of re-hitting the model, so large-scale re-extraction/re-runs
# become near-free. On by default. LLM_CACHE_SIZE_LIMIT is a byte cap (default below
# is 2 GiB); past it, least-recently-used entries are evicted first. Entries older
# than LLM_CACHE_TTL_DAYS are treated as expired.
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=.local/llm_cache_v2.db
LLM_CACHE_SIZE_LIMIT=2147483648
LLM_CACHE_TTL_DAYS=90

# Extraction self-verify: after each window, one extra LLM pass drops hallucinated nodes.
KG_REFINE_ENABLED=true
# Gleaning: after the first extraction, up to N extra rounds ask the LLM for MISSED nodes.
KG_GLEANING_ENABLED=true
KG_GLEANING_ROUNDS=1
# Concept-cluster description fusion: cross-doc concept clusters (>=2 members) get one
# LLM-fused description from their evidence.
KG_CONCEPT_DESC_ENABLED=true
# Community summaries: LLM title/summary/findings per Louvain community (needed for
# Global search, ask mode="global").
KG_COMMUNITY_SUMMARY_ENABLED=false

# Answer-context assembly char budget (always on): total budget + keep >= N items.
ANSWER_CONTEXT_BUDGET_CHARS=6000
ANSWER_CONTEXT_MIN_ITEMS=3
# Retrieval ranking: BM25 (Okapi) + RRF fusion instead of the default keyword+semantic
# weighted fusion. RETRIEVAL_RRF_K = reciprocal-rank-fusion k. (Tune before enabling.)
RETRIEVAL_RRF_ENABLED=false
RETRIEVAL_RRF_K=60
# Question-aware evidence refinement: before answering, extract the question-relevant
# points from the assembled evidence and prepend them. DEFAULT ON (eval: correctness up
# + fabricated citations -> 0; cost: 1 extra LLM call per ask). Set false to disable.
KG_QUERY_REFINE_ENABLED=true
QUERY_REFINE_MAX_CHARS=4000
# Global map-reduce QA (ask mode="global"): max community reports considered (by size).
GLOBAL_MAX_COMMUNITIES=20
# Relation-vector retrieval for graph/reasoning seeds: when enabled, the retrieval
# path also queries the relation-embedding index and merges hits as graph seeds.
# Opt-in pending eval (default off). RELATION_SEED_TOP_N = hits fed to graph seeds.
RELATION_RETRIEVAL_ENABLED=false
RELATION_SEED_TOP_N=8
# KG retrieval-quality pass (default off, opt-in pending eval):
KG_CANONICAL_FOLD_ENABLED=false
KG_ABOUT_DOWNWEIGHT_ENABLED=false
KG_ISOLATED_RANK_PENALTY=0.5  # 孤立(无边)KG 节点的检索排序降权乘子;仅压 score 不动 relevance
# Knowhow 表投影出的格子知识对象默认进入 reasoning/graph 的 KG-node 检索；
# 设 false 只回滚直接节点路径，格子 chunk 仍参与普通检索。
KNOWHOW_KG_NODE_RETRIEVAL_ENABLED=true

# 逐步推理的类型化集合枚举工具（enumerate_elements / enumerate_kg_objects）总开关；
# 设 false 完全回到接入前：reflect 既不提供这两个动作也不注入集合地图，零额外查询。
REASONING_ENUM_TOOLS_ENABLED=true

# 逐步推理的大纲便签（reflect 动作 update_outline，仅「穷尽」检索档位提供）总开关；
# 设 false 回到接入前：该动作不出现在 prompt/schema/allowed_actions，按节合成也不触发。
REASONING_OUTLINE_ENABLED=true

# 大纲便签的 KG 弱支撑边回喂（叠在上面的大纲开关之上）；设 false 后大纲便签不再附带
# 「支撑薄弱的相关关系」提示，也不再发出对应的图谱探测查询（零额外开销的回退口）。
REASONING_OUTLINE_KG_GAP_ENABLED=true

# 跨文档概念合并预审(merges/review)的非对称自动落地阈值。单一 0.95 时多数判定落 unsure→
# 队列永不清空。非对称:auto-merge 需更高置信(误并污染图、不可逆);auto-keep-separate
# 可低些(误判仅多留一对待审、无害)。
KG_MERGE_CONFIRM_THRESHOLD=0.90   # LLM 判 merge 时,≥此置信才自动确认合并
KG_MERGE_SEPARATE_THRESHOLD=0.80  # LLM 判 keep_separate 时,≥此置信才自动驳回(保持分开)

# 常用功能开关（默认值见右侧；按需改）
KG_AUTO_EXTRACT=false                 # true=上传源后自动抽取 KG（默认按需手动建图）
KG_INCREMENTAL_FUSION_ENABLED=true    # 上传新源时自动增量融合进统一 KG
KG_CONFLICT_RESOLUTION_ENABLED=false  # 冲突检测→LLM 裁决→写回 + 评审队列
GRAPH_PPR_ENABLED=true                # reasoning/graph 走 HippoRAG 式 PPR 跨文档传播
SOURCE_SUBGRAPH_PPR_ENABLED=true      # 所选来源 snapshot 内的稀疏 PPR（默认仅作不可见 Shadow）
SOURCE_PARTITIONED_GRAPH_ARTIFACTS_ENABLED=true  # 按来源构建大图伴生产物
SOURCE_PARTITIONED_PPR_ENABLED=true   # 读取上述伴生产物的 Shadow PPR
SOURCE_PARTITIONED_PPR_MAX_ITERATIONS=30 # 按来源 partition PPR 的整 CSR 迭代上限
SELECTED_SOURCE_GRAPH_ROLLOUT_MODE=shadow # off|shadow|allowlist|rollout|on；Shadow 不进入 API/trace/UI
SELECTED_SOURCE_GRAPH_ATTESTATION_PATH= # active 模式读取的部署受信质量证明 JSON
SELECTED_SOURCE_GRAPH_EXPECTED_CORPUS_SIGNATURE= # active 必填：期望语料签名
SELECTED_SOURCE_GRAPH_EXPECTED_MODEL_JSON= # active 必填：与 attestation 一致的模型 JSON
SELECTED_SOURCE_GRAPH_NOTEBOOK_ALLOWLIST= # allowlist 模式，逗号分隔 notebook id
SELECTED_SOURCE_GRAPH_ROLLOUT_PERCENT=0 # rollout 模式稳定 hash 百分比
SELECTED_SOURCE_GRAPH_ENRICHMENT_TOKENS=4000 # G 的独立 token 预算，不挤占历史 B
PPR_DAMPING=0.5                       # PageRank 阻尼系数 α（越小传播越广）
PPR_TOP_CHUNKS=20                     # PPR 后最终喂给答案的 chunk 数
PPR_VARIANT_EDGE_WEIGHT=0.5           # 变体/别名边的权重（相对于主边 1.0）
PPR_EMB_SYNONYM_ENABLED=true          # 嵌入 KNN 跨文档同义边，PPR 建图时合成，可调
PPR_EMB_SYNONYM_THRESHOLD=0.83        # 判为同义的余弦相似度下界（越高越保守，误边越少）
PPR_EMB_SYNONYM_TOPK=20               # 每个实体查 KNN 取最近的 K 个候选
PPR_EMB_SYNONYM_MAX_ENTITIES=50000    # 成本护栏：实体数超过此值时跳过嵌入同义边构建
QUERY_REWRITE_ENABLED=true            # 问答前查询改写/扩展

# === Retrieval / extraction tuning (advanced; defaults are usually fine) ===
RETRIEVAL_TOP_N=20                    # 推理/报告合成证据预算下界(每问最少保留的 KG 候选)
REASONING_PER_QUERY_LIMIT=8           # 无检索档位的兼容调用：每个子查询取数
REASONING_TOP_N_PER_QUERY=3           # 自适应:每方面(子查询,含社区兄弟)保底席位
REASONING_TOP_N_CAP=36                # 自适应上限(对比题按方面数扩容,封顶防 prompt 爆)
ASK_RELATED_KNOWLEDGE_LIMIT=12        # Ask 响应里可见的相关知识条目上限
QUERY_REFINE_MAX_ITEMS=12             # 问题感知证据精炼最多前置的相关要点数
ASK_CONTEXT_RELATION_LIMIT=30         # 答题证据上下文最多拼入的支持关系数
GRAPH_SEED_TOP_N=5                    # graph 模式起始 KG 种子数
GRAPH_MAX_DEPTH=3                     # graph 多跳遍历深度
GRAPH_MAX_FAN_OUT=8                   # graph 每层扇出上限
PROC_MIN=2
# grounded 三档阈值(作用于融合相关度 [0,1])。
EVIDENCE_TAU_LOW=0.18
EVIDENCE_TAU_HIGH=0.35
# Reasoning mode (mode=reasoning) guardrails + interactive short timeout/retries.
REASONING_MAX_STEPS=50
REASONING_MAX_SUBQUERIES=5
REASONING_MAX_PPR_RETRIEVES=3
REASONING_MAX_EXACT_LOOKUPS=3
REASONING_MAX_FOLLOW_CHAIN_ACTIONS=3
REASONING_COMMUNITY_PEERS_CAP_FACTOR=2
REASONING_MAX_OUTLINE_UPDATES=6
# 一次 expand_graph 每个方向(出边/入边)最多展开的**唯一**1-hop 邻居数(重复关系
# 与不可查边不占预算,数据库读取按该值的四倍过扫描有界);超出时轨迹与 reflect
# 回喂都会披露「只展开了一部分」,不静默。
REASONING_NEIGHBOR_EXPAND_LIMIT=1000
REASONING_TIMEOUT_SECONDS=90
REASONING_MAX_RETRIES=1
# Embedding batching + sqlite busy timeout + LLM connection retries.
EMBED_TRUNCATE_CHARS=2000
EMBED_BATCH_SIZE=10
EMBED_PERSIST_CHUNK=200
DB_BUSY_TIMEOUT_MS=30000
# Process-wide SQLite write-lock instrumentation: records wait/hold time per call
# site. DB_WRITE_LOCK_STATS enables it; DB_WRITE_LOCK_WARN_MS is the wait/hold
# threshold (ms) that logs a rate-limited db_write_lock_slow event;
# DB_WRITE_LOCK_FLUSH_SECONDS is both the periodic full-snapshot
# (db_write_lock_stats) interval and the per-call-site rate-limit window for
# db_write_lock_slow. See `python3 scripts/diag.py locks`.
DB_WRITE_LOCK_STATS=true
DB_WRITE_LOCK_WARN_MS=200
DB_WRITE_LOCK_FLUSH_SECONDS=60
# SQLite per-connection page cache (KB; negative = KB). Connections are reused
# per-thread, so total memory ~= threads x |value|. Default 16MB; raise for
# read-heavy online serving, lower for many-worker batch ingest.
SQLITE_CACHE_SIZE_KB=-16384
OPENAI_COMPAT_MAX_RETRIES=2

# LLM interaction logging: records every chat/embedding call (request, response,
# latency, tokens, errors) to a JSONL file plus a brief console line. Defaults
# on; it is a no-op when no LLM is configured (offline).
LLM_LOG_ENABLED=true
LLM_LOG_PATH=.local/logs/llm.jsonl
LLM_LOG_MAX_CHARS=4000
# Conservative model-JSON recovery for reasoning_agent/ask_answer only:
# off=strict, shadow=measure repairability but reject, on=repair safe complete
# object-shaped syntax faults such as missing quotes/commas. Truncation remains rejected.
MODEL_JSON_REPAIR_MODE=on

# General event logging: HTTP requests + async pipeline stages + status
# transitions, written to <EVENT_LOG_DIR>/<channel>.jsonl plus the console.
# Tail .local/logs/requests.jsonl and .local/logs/events.jsonl to see what the
# app is doing and where an upload is stuck. SLOW_REQUEST_MS flags slow calls.
EVENT_LOG_ENABLED=true
EVENT_LOG_DIR=.local/logs
SLOW_REQUEST_MS=3000

# Read-only browser/API viewer for .local/logs records. Full LLM records may
# include prompt/response text from private source material, so this is opt-in.
DEBUG_LOGS_ENABLED=false

# /dev/logs "Activity" view (the default tab: per-user asks/sources/reports
# merged into one timeline). Independent of DEBUG_LOGS_ENABLED above -- this
# gates a user's own (or, for admins, any user's) question/answer text and
# source list, not JSONL log file reads. Defaults on since Activity is the
# default tab; set to false only if cross-user question/answer visibility for
# admins is a concern in your deployment. The frontend reads this via
# GET /system/config and hides the "Activity" tab (falling back to "Model
# calls") when it's off, instead of defaulting into a tab whose endpoints
# all 404.
USER_ACTIVITY_VIEW_ENABLED=true

# PDF parsing via MinerU (formulas/tables/layout). Leave MINERU_MODE=off on
# machines without a GPU; PDFs then use the local PyMuPDF4LLM layout/Markdown
# fallback (pypdf remains the last-resort parser).
# On the GPU deployment host, run `mineru-api` and point MINERU_API_URL at it:
#   MINERU_MODE=http
#   MINERU_API_URL=http://<gpu-host>:8000
# Or run MinerU's Python API in an isolated subprocess on the same host:
# MINERU_MODE=cli (requires the `mineru` Python package installed).
# To offload only the VLM model to a standalone vllm/sglang server, use a client
# backend (MINERU_BACKEND=vlm-http-client) and set MINERU_VLM_SERVER_URL.
MINERU_MODE=off
MINERU_API_URL=
MINERU_BACKEND=pipeline
MINERU_VLM_SERVER_URL=
MINERU_PARSE_METHOD=auto
MINERU_LANG=
MINERU_MODEL_SOURCE=huggingface
# Inline parsing (http/cli) holds one connection/subprocess open for the whole
# document; hitting this timeout is treated as a MinerU failure and falls back
# to the local Python PDF parser. Raise it (e.g. 1800) for large PDFs or local VLM full-paper
# parsing rather than losing fidelity.
MINERU_TIMEOUT_SECONDS=600
# Extra attempts after transient remote HTTP failures (network/timeout,
# HTTP 408/425/429/5xx, or an empty/non-JSON response). Default 2 means at
# most 3 total attempts. Applies to MINERU_MODE=http and mineru.net cloud I/O;
# explicit 4xx and terminal parse failures are not retried.
MINERU_MAX_RETRIES=2
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# MinerU.net cloud (v4) — parse public PDF URLs via the hosted service.
# 用于「添加链接」加入的 PDF 来源；当上面的本地 MinerU（MINERU_MODE=http/cli）
# 已配置时，URL 来源会优先走本地解析（内网部署下 PDF 不外发），仅在未配置本地
# 时回退到此云端 token。从 https://mineru.net/apiManage/docs 申请 token 后填入：
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net
MINERU_CLOUD_MODEL_VERSION=vlm
MINERU_CLOUD_LANGUAGE=ch
MINERU_CLOUD_FORMULA_ENABLE=true
MINERU_CLOUD_TABLE_ENABLE=true
MINERU_CLOUD_TIMEOUT_SECONDS=600
MINERU_CLOUD_POLL_INTERVAL_SECONDS=5

# ── MinerU batch PDF→Markdown tool (scripts/mineru_batch_parse.py) ──────────
# Standalone deployment-side CLI, not read by the backend process: offline/bulk
# PDF→Markdown parsing via your internal MinerU server's ASYNC /tasks API
# (submit/poll/fetch), load-balanced across N servers. Independent of the
# MINERU_* (sync /file_parse, above) and MINERU_CLOUD_*/mineru.net config.
# Feeds scripts/batch_ingest.py: PDF dir -> mineru_batch_parse.py -> MD dir -> KG.
MINERU_BATCH_SERVERS=http://mineru-host:8000,http://mineru-host:8001
MINERU_BATCH_SRC_DIR=/path/to/pdf/books
MINERU_BATCH_OUT_DIR=/path/to/output
MINERU_BATCH_BACKEND=pipeline
MINERU_BATCH_LANG=ch
MINERU_BATCH_FORMULA_ENABLE=true
MINERU_BATCH_TABLE_ENABLE=true
MINERU_BATCH_CONCURRENCY_PER_SERVER=0   # 0 = auto from each server's /health max_concurrent_requests
MINERU_BATCH_POLL_INTERVAL=10
MINERU_BATCH_MAX_POLL_SECONDS=1800
MINERU_BATCH_RETRY_MAX=3
MINERU_BATCH_SUBMIT_TIMEOUT=120
MINERU_BATCH_RESULT_TIMEOUT=120
MINERU_BATCH_MANIFEST=                  # empty -> {MINERU_BATCH_OUT_DIR}/_manifest.jsonl

# 用户系统 / User accounts
# admin 账号初始密码（本地默认值；production 或 BACKEND_HOST 对外监听时必须改成强密码）
SILICON_NOTEBOOK_ADMIN_PASSWORD=admin
# true 时无 token 的请求回退为 admin（仅本地/测试）；生产留 false=强制登录
SILICON_NOTEBOOK_AUTH_OPTIONAL=false
# 有效 session 至多每隔多少秒刷新一次 last_seen/expires，避免每个请求都写 SQLite
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300

# MCP HTTPS 强制(默认关):不设=允许远程明文 HTTP + 放宽 Host/Origin 校验(仅可信内网,
# 启动打印明文告警)。公网部署设为 1 恢复 fail-closed(强制 HTTPS + DNS-rebinding 保护)。
# MCP_REQUIRE_HTTPS=1
# Agent 客户端真正可达的精确 /mcp 地址；同时写入公开机器接入说明。
# MCP_PUBLIC_URL=https://notebook.example.com/mcp

DATABASE_URL=sqlite:///.local/silicon_notebook.db
# Exactly one direct backend is selected here. SQLite remains the shipped default;
# PostgreSQL is supported after you provision a UTF8 database and take/verify backups.
# DATABASE_URL=postgresql://user:password@localhost:5432/silicon_notebook?sslmode=require
# Optional PostgreSQL target for the explicit SQLite->PostgreSQL shadow CLI.
# Setting this alone starts nothing and never changes the active DATABASE_URL backend.
# SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/silicon_notebook
# POSTGRES_POOL_MIN_SIZE=1
# POSTGRES_POOL_MAX_SIZE=10
# POSTGRES_POOL_ACQUIRE_TIMEOUT_SECONDS=10
# POSTGRES_STATEMENT_TIMEOUT_SECONDS=30
# POSTGRES_LOCK_TIMEOUT_SECONDS=5
SILICON_NOTEBOOK_STORAGE_DIR=.local/storage
# 进程崩溃遗留的 copying notebook 至少多久后才允许回收；活跃复制绝不能被清理
NOTEBOOK_COPY_STALE_SECONDS=3600
# 允许跨域的前端来源(逗号分隔)。部署到服务器时改成浏览器实际访问的前端来源,
# 如 http://<服务器IP或域名>:3000。不能用 *(后端开了 credentials)。
SILICON_NOTEBOOK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# 前端调用的后端 API 基址。NEXT_PUBLIC_* 是 Next.js 构建期烘焙进包的(改后要重新 build):
#  - 开发(npm run dev / scripts/dev.sh)会从本文件读到;
#  - 生产(npm run build)需放到 frontend/.env.local(或 build 命令的环境)才生效。
# 单台同机部署 + 远程访问推荐填相对路径 /api(走 next.config.mjs 的同源反代,免 CORS、
#   后端不必对外暴露);前后端分不同 host 才填 http://<服务器IP或域名>:8000/api。
# 任何情况都别用 localhost/127.0.0.1(那指访客自己的机器)。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ── chunk-native 通用问答 + chunk×graph mix ──────────────────────────────
# 通用问答(mode=chunk)走 chunk-native:大召回 → 选择 → 长上下文综合。
CHUNK_RECALL=200               # 每子查询 chunk 大召回数(mix 候选池 / 无 rerank 时 MMR 候选)
CHUNK_MMR_K=16                 # 无 rerank 时 MMR 精选的 chunk 数
# 可选「生成搜索问题 → 原 chunk」补召回。默认 off 完全零成本；先用 shadow 做无正文 A/B，
# 只有显式 on 才能在低召回时追加原 chunk。离线构建另需 TOML 绑定
# chunk_question_generation + chunk_embedding，命令见 docs/operations_zh.md。
GENERATED_QUESTION_INDEX_MODE=off       # off | shadow | on
GENERATED_QUESTION_QUESTIONS_PER_CHUNK=3
GENERATED_QUESTION_TRIGGER_HITS=5
GENERATED_QUESTION_RECALL=40
GENERATED_QUESTION_MAX_SCAN_ROWS=10000
# 大库暴力回退守卫:chunk ANN 不可用(未建 scale 索引/embed 失败)时,chunk 数超过
# 该阈值的库不再全表扫描+全量分词(大库单问可磨半小时),改走 FTS 词法候选+有界打分,
# 并发 chunk_bruteforce_skipped 事件(diag_slow.py 可见)。真解=建 scale 索引。0=关守卫。
CHUNK_BRUTEFORCE_MAX_CHUNKS=20000
# chunk×graph mix:把 KG 局部结构(实体 + 1-hop 关系)及其源 chunk 叠加进 chunk 答案。
# `retrieval_rerank` 在部署 TOML 中绑定了服务时使用精排，否则回退纯 chunk MMR。
CHUNK_KG_OVERLAY_ENABLED=true
CHUNK_KG_NODE_SEED_TOP_N=20           # chunk×KG overlay 的节点种子宽度
CHUNK_KG_RELATION_SEED_TOP_N=10       # chunk×KG overlay 的关系种子宽度
CHUNK_KG_MAX_DEPTH=1                  # chunk×KG overlay 的图遍历深度
CHUNK_KG_FAN_OUT=8                    # chunk×KG overlay 的邻居扇出上限
# 最终候选至少给满足既有相关度门槛、且仅由图路径召回的 chunk 预留此席位数；
# 不扩大 token 预算，0 可回滚为纯全局排序。
CHUNK_GRAPH_RESERVE=0
# 精确标识符通道：问题含 `_`/`-`/`.` 连接的完整标识符（如命令名 set_db）时,
# 先精确子串定位命中章节并取齐该节全部 chunk。无标识符的问题零新增查询。
EXACT_LOOKUP_ENABLED=true
EXACT_LOOKUP_MAX_IDENTIFIERS=3   # 每问题最多取前 N 个标识符做精确探测
EXACT_LOOKUP_FTS_K=50            # 每标识符的精确匹配候选窗
EXACT_LOOKUP_MAX_SECTIONS=3      # 每标识符最多取齐的章节数
EXACT_LOOKUP_MAX_CHUNKS_PER_SECTION=12   # 每章节取齐的 chunk 硬上限
EXACT_SECTION_RESERVE=4          # mix 选择时给精确章节 chunk 的预算内保底席位
# 精排候选批大小；并发仍由绑定服务的 `max_concurrency` 统一控制。
RERANK_MAX_DOCS=500            # 单请求文档上限,超出自动切 batch 并发再按分合并
# mix token 预算(照 LightRAG 实际值):实体段 / 关系段 / 总预算。chunk 段吃总预算余量。
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000

# ── KG 关系补全（默认严格关闭）────────────────────────────────────────────
# 按当前来源代次的持久 keyset 水位逐页处理有界跨元素候选，只用索引化关系检查与同源
# FTS/ANN 有界 overfetch，不全扫整本书/整库；模型只能选择服务端签发的对象、关系类型
# 与证据元素，随后还要经过独立 verifier 与提交前代次 CAS。
KG_RELATION_COMPLETION_MODE=off       # off | shadow（只观测）| write（写 pending 边）
KG_RELATION_COMPLETION_NOTEBOOK_ALLOWLIST=  # 逗号分隔 notebook id；* 表示全部
KG_RELATION_COMPLETION_ROLLOUT_PERCENT=0    # 对未命中 allowlist 的 notebook 做稳定哈希灰度
KG_RELATION_COMPLETION_MAX_OBJECTS=160
KG_RELATION_COMPLETION_MAX_PAIRS=120
KG_RELATION_COMPLETION_SECTION_QUOTA=24
KG_RELATION_COMPLETION_BATCH_PAIRS=24
KG_RELATION_COMPLETION_MAX_BATCHES=4
KG_RELATION_COMPLETION_EXCERPT_CHARS=800
KG_RELATION_COMPLETION_MAX_PAGES_PER_RUN=4
KG_RELATION_COMPLETION_NEIGHBOR_TOP_K=8
KG_RELATION_COMPLETION_CANDIDATE_OVERFETCH=64
KG_RELATION_COMPLETION_BATCH_CHARS=48000

# --- 深度报告(notebook 级后台任务:大纲→逐节完整深挖并行→三层证据撰写→汇总) ---
# 大纲最大章节数。
REPORT_MAX_SECTIONS=6
REPORT_MAX_SUBQUERIES_PER_SECTION=4  # 每节可执行的检索方向上限（前后端共用）
REPORT_PROBE_ELEMENT_LIMIT=8          # 规划/方向补检索的直接元素候选数
REPORT_SCOUT_KG_LIMIT=12              # 语料侦察地图的 KG 候选数
REPORT_SCOUT_CHUNK_LIMIT=8            # 语料侦察地图的 PPR chunk 候选数
REPORT_SCOUT_MEMORY_LIMIT=8           # 语料侦察地图的已确认 Memory 候选数
# (每节 KG 预算已与 ask 统一:走 RETRIEVAL_TOP_N / REASONING_TOP_N_* 自适应,无报告专属旋钮。)
# 每节 chunk 上下文字预算。
REPORT_SECTION_CHUNK_BUDGET=20000
# 报告并发和各阶段输出上限集中配置在文件顶部的模型预算段，
# 避免同一个环境变量在示例中出现两次并互相覆盖。
# 高风险断言审计始终披露；证据等级自动降级默认关闭，待真机分布校准后再启用。
REPORT_HIGH_RISK_UNSUPPORTED_RATIO=0.25
REPORT_HIGH_RISK_DOWNGRADE_ENABLED=false
# 允许【通识】层(库外通识,行内标注且提示未经验证);仅报告管线读取,不影响三种问答模式的严格 grounding。
REPORT_ALLOW_PARAMETRIC=true
