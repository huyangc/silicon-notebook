{
  "name": "silicon-notebook-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:ui-plugins": "node scripts/sync-ui-plugins.mjs",
    "postinstall": "npm run sync:ui-plugins",
    "predev": "npm run sync:ui-plugins",
    "dev": "next dev",
    "prebuild": "npm run sync:ui-plugins",
    "build": "next build",
    "prestart": "npm run sync:ui-plugins",
    "start": "next start",
    "pretest": "npm run sync:ui-plugins",
    "test": "npm run test:node && npm run test:component",
    "test:node": "node --test --test-concurrency=4 $(find tests/unit tests/guards -name '*.test.mjs' -type f -print)",
    "test:component": "vitest run",
    "prelint": "npm run sync:ui-plugins",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "katex": "^0.17.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^26.1.0",
    "postcss": "8.4.31",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
